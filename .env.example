# ── Database ──────────────────────────────────────────────
# Local: `npm run db:up` starts PostgreSQL 17 on 54329.
# Production: Neon (Frankfurt) connection string.
DATABASE_URL=postgres://eventat:eventat@127.0.0.1:54329/eventat_dev

# ── Auth (Better Auth) ────────────────────────────────────
BETTER_AUTH_SECRET=change-me-32-bytes-minimum-random-string
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000

# ── Payments ──────────────────────────────────────────────
# simulated = built-in test checkout, no real money (dev, demo)
# stripe    = Stripe Connect (needs the keys below)
PAYMENT_PROVIDER=simulated
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# ── Email ─────────────────────────────────────────────────
# outbox   = stored in the database only, visible in Админ → Имейли (dev)
# postmark / resend = real sending
EMAIL_TRANSPORT=outbox
EMAIL_FROM="EventAT <no-reply@eventat.bg>"
EMAIL_REPLY_TO=help@eventat.bg
POSTMARK_TOKEN=
RESEND_API_KEY=

# ── File storage ──────────────────────────────────────────
# local = public/uploads + .data/uploads for private files (dev) · s3 = Cloudflare R2 or any S3-compatible storage
# S3_BUCKET holds public files (S3_PUBLIC_URL serves it); S3_PRIVATE_BUCKET is a second bucket with no public access.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_BUCKET=
S3_PRIVATE_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# ── Jobs ──────────────────────────────────────────────────
# Vercel Cron calls /api/cron/tick with this bearer token.
CRON_SECRET=change-me

# ── Demo ──────────────────────────────────────────────────
# Lets the clock be moved forward in Админ → Настройки for demos and tests. Never in production.
ALLOW_TIME_TRAVEL=true

# Local end-to-end runs only: switch off the sign-in, reset, code and sign-up rate limits (Better Auth's
# and lib/domain/throttle's), which a suite signing in and registering many times from one address would hit.
# AUTH_RATE_LIMIT=off
